<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yupi.yuojbackendquestionservice.mapper.DiscussionFavourMapper">

    <resultMap id="BaseResultMap" type="com.yupi.yuojbackendmodel.model.entity.DiscussionFavour">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="discussionId" column="discussionId" jdbcType="BIGINT"/>
        <result property="userId" column="userId" jdbcType="BIGINT"/>
        <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,discussionId,userId,
        createTime,updateTime
    </sql>

    <select id="listFavourDiscussionByPage"
            resultType="com.yupi.yuojbackendmodel.model.entity.Discussion">
        select p.*
        from discussion p
                 join (select discussionId from discussion_favour where userId = #{favourUserId}) pf
                      on p.id = pf.discussionId ${ew.customSqlSegment}
    </select>
</mapper>
